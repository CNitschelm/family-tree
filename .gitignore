# DENY BY DEFAULT. Nothing in this folder is committed unless it is listed below.
# Rationale (14 Aug 2026): the old gitignore named research files one by one, so any
# NEW file carrying names was tracked by default and one slip put it in a public repo.
# Inverting it makes an accidental commit of research material impossible.
*
!*/

# --- the entire published site and its tooling ---
!/.gitignore
!/.gitattributes
!/.github/workflows/test.yml
!/.github/workflows/verify-deploy.yml
!/README.md
!/CLAUDE.md
!/OPERATING.md
!/index.html
!/favicon.png
!/favicon.ico
!/favicon.svg
!/apple-touch-icon.png
!/CNAME
!/robots.txt
# the bio pictures, AES-GCM encrypted under the payload key (tools/payload.js); tests/run.js §14
# proves every file there opens with that key, so nothing readable can be filed under this name
!/media/*.bin
# the map's base layers (public geography, no family data; tools/mapfile.js) — tests/run.js decodes them
!/map/*.json
!/checks/*.js
!/tests/run.js
!/tests/ledger.js
!/tests/browser.js
!/tests/research.js
!/tools/*.js
!/githooks/*

# Adding a file to the site? Add an explicit "!" line for it here, and only after
# checking it carries no personal data — `node tests/run.js` enforces that.
